      <bt:Images>
        <bt:Image id="Icon.Insert.16" DefaultValue="{{BASE_URL}}/addin/icons/insert-16.png"/>
        <bt:Image id="Icon.Insert.32" DefaultValue="{{BASE_URL}}/addin/icons/insert-32.png"/>
        <bt:Image id="Icon.Insert.80" DefaultValue="{{BASE_URL}}/addin/icons/insert-80.png"/>
        <bt:Image id="Icon.Ocr.16" DefaultValue="{{BASE_URL}}/addin/icons/ocr-16.png"/>
        <bt:Image id="Icon.Ocr.32" DefaultValue="{{BASE_URL}}/addin/icons/ocr-32.png"/>
        <bt:Image id="Icon.Ocr.80" DefaultValue="{{BASE_URL}}/addin/icons/ocr-80.png"/>
        <bt:Image id="Icon.Edit.16" DefaultValue="{{BASE_URL}}/addin/icons/edit-16.png"/>
        <bt:Image id="Icon.Edit.32" DefaultValue="{{BASE_URL}}/addin/icons/edit-32.png"/>
        <bt:Image id="Icon.Edit.80" DefaultValue="{{BASE_URL}}/addin/icons/edit-80.png"/>
