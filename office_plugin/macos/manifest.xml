                  <Action xsi:type="ExecuteFunction"><FunctionName>deleteSelected</FunctionName></Action>
                </Control>
              </Group>
              <Group id="LaTeXSnipper.PowerPoint.Style">
                <Label resid="Group.Style"/>
                <Icon><bt:Image size="16" resid="Icon.Format.16"/><bt:Image size="32" resid="Icon.Format.32"/><bt:Image size="80" resid="Icon.Format.80"/></Icon>
                <Control xsi:type="Button" id="LaTeXSnipper.PowerPoint.FormatSelected">
                  <Label resid="FormatSelected.Label"/>
                  <Supertip><Title resid="FormatSelected.Label"/><Description resid="FormatSelected.Tip"/></Supertip>
                  <Icon><bt:Image size="16" resid="Icon.Format.16"/><bt:Image size="32" resid="Icon.Format.32"/><bt:Image size="80" resid="Icon.Format.80"/></Icon>
                  <Action xsi:type="ExecuteFunction"><FunctionName>formatSelected</FunctionName></Action>
                </Control>
                <Control xsi:type="Button" id="LaTeXSnipper.PowerPoint.FormatAll">
                  <Label resid="FormatAll.Label"/>
                  <Supertip><Title resid="FormatAll.Label"/><Description resid="FormatAll.Tip.PowerPoint"/></Supertip>
                  <Icon><bt:Image size="16" resid="Icon.FormatAll.16"/><bt:Image size="32" resid="Icon.FormatAll.32"/><bt:Image size="80" resid="Icon.FormatAll.80"/></Icon>
                  <Action xsi:type="ExecuteFunction"><FunctionName>formatAll</FunctionName></Action>
                </Control>
              </Group>
              <Group id="LaTeXSnipper.PowerPoint.Tools">
                <Label resid="Group.Tools"/>
                <Icon><bt:Image size="16" resid="Icon.Pane.16"/><bt:Image size="32" resid="Icon.Pane.32"/><bt:Image size="80" resid="Icon.Pane.80"/></Icon>
                <Control xsi:type="Button" id="LaTeXSnipper.PowerPoint.TaskPane">
                  <Label resid="TaskPane.Label"/>
                  <Supertip><Title resid="TaskPane.Label"/><Description resid="TaskPane.Tip"/></Supertip>
                  <Icon><bt:Image size="16" resid="Icon.Pane.16"/><bt:Image size="32" resid="Icon.Pane.32"/><bt:Image size="80" resid="Icon.Pane.80"/></Icon>
                  <Action xsi:type="ShowTaskpane"><TaskpaneId>LaTeXSnipper.TaskPane</TaskpaneId><SourceLocation resid="Taskpane.Url"/></Action>
                </Control>
                <Control xsi:type="Button" id="LaTeXSnipper.PowerPoint.Settings">
                  <Label resid="Settings.Label"/>
                  <Supertip><Title resid="Settings.Label"/><Description resid="Settings.Tip"/></Supertip>
                  <Icon><bt:Image size="16" resid="Icon.Settings.16"/><bt:Image size="32" resid="Icon.Settings.32"/><bt:Image size="80" resid="Icon.Settings.80"/></Icon>
                  <Action xsi:type="ExecuteFunction"><FunctionName>openSettings</FunctionName></Action>
                </Control>
                <Control xsi:type="Button" id="LaTeXSnipper.PowerPoint.Help">
                  <Label resid="Help.Label"/>
                  <Supertip><Title resid="Help.Label"/><Description resid="Help.Tip"/></Supertip>
                  <Icon><bt:Image size="16" resid="Icon.Help.16"/><bt:Image size="32" resid="Icon.Help.32"/><bt:Image size="80" resid="Icon.Help.80"/></Icon>
                  <Action xsi:type="ExecuteFunction"><FunctionName>openHelp</FunctionName></Action>
                </Control>
              </Group>
              <Label resid="Tab.Label"/>
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
