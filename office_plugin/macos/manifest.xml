      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="在 LaTeXSnipper 选项卡中插入、编辑公式或接收截图识别结果。"><bt:Override Locale="en-US" Value="Use the LaTeXSnipper tab to insert and edit formulas or receive screenshot OCR results."/></bt:String>
        <bt:String id="Insert.Tip" DefaultValue="打开公式编辑器。"><bt:Override Locale="en-US" Value="Open the formula editor."/></bt:String>
        <bt:String id="Ocr.Tip" DefaultValue="等待桌面端的下一次截图识别结果；再次点击取消。"><bt:Override Locale="en-US" Value="Wait for the next desktop screenshot OCR result; click again to cancel."/></bt:String>
        <bt:String id="EditSelected.Tip" DefaultValue="将所选 LaTeXSnipper 公式载入编辑器。"><bt:Override Locale="en-US" Value="Load the selected LaTeXSnipper formula into the editor."/></bt:String>
        <bt:String id="DeleteSelected.Tip" DefaultValue="删除所选 LaTeXSnipper 公式。"><bt:Override Locale="en-US" Value="Delete the selected LaTeXSnipper formulas."/></bt:String>
        <bt:String id="FormatSelected.Tip" DefaultValue="将所选插件公式重置为默认样式和自然尺寸。"><bt:Override Locale="en-US" Value="Reset the selected plugin formulas to the default style and natural size."/></bt:String>
        <bt:String id="FormatAll.Tip.Word" DefaultValue="将文档中的全部插件公式重置为默认样式和自然尺寸。"><bt:Override Locale="en-US" Value="Reset every plugin formula in the document to the default style and natural size."/></bt:String>
        <bt:String id="FormatAll.Tip.PowerPoint" DefaultValue="将演示文稿中的全部插件公式重置为默认样式和自然尺寸。"><bt:Override Locale="en-US" Value="Reset every plugin formula in the presentation to the default style and natural size."/></bt:String>
        <bt:String id="TaskPane.Tip" DefaultValue="显示状态窗格。"><bt:Override Locale="en-US" Value="Show the status pane."/></bt:String>
        <bt:String id="Settings.Tip" DefaultValue="打开插件设置。"><bt:Override Locale="en-US" Value="Open plugin settings."/></bt:String>
        <bt:String id="Help.Tip" DefaultValue="查看插件帮助。"><bt:Override Locale="en-US" Value="View plugin help."/></bt:String>
