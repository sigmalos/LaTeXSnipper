                <Icon><bt:Image size="16" resid="Icon.Edit.16"/><bt:Image size="32" resid="Icon.Edit.32"/><bt:Image size="80" resid="Icon.Edit.80"/></Icon>
                <Control xsi:type="Button" id="LaTeXSnipper.PowerPoint.EditSelected">
                  <Label resid="EditSelected.Label"/>
                  <Supertip><Title resid="EditSelected.Label"/><Description resid="EditSelected.Tip"/></Supertip>
                  <Icon><bt:Image size="16" resid="Icon.Edit.16"/><bt:Image size="32" resid="Icon.Edit.32"/><bt:Image size="80" resid="Icon.Edit.80"/></Icon>
                  <Action xsi:type="ExecuteFunction"><FunctionName>editSelected</FunctionName></Action>
                </Control>
                <Control xsi:type="Button" id="LaTeXSnipper.PowerPoint.DeleteSelected">
                  <Label resid="DeleteSelected.Label"/>
