        <bt:Image id="Icon.Format.32" DefaultValue="{{BASE_URL}}/addin/icons/format-32.png"/>
        <bt:Image id="Icon.Format.80" DefaultValue="{{BASE_URL}}/addin/icons/format-80.png"/>
